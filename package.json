{
  "name": "@vejadu/wincmux",
  "version": "0.1.0",
  "type": "module",
  "description": "Voice-controlled command prompt manager for GitHub Copilot agent sessions",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "wincmux": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"

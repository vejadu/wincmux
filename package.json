    "node-pty": "^1.1.0",
    "react": "^18.0.0"
  },
  "optionalDependencies": {
    "@azure/msal-node": "^2.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.0",
    "@picovoice/porcupine-node": "^3.0.0",
